# Supabase API 地址。必填。
# 本地获取：运行 `npx supabase status -o env`，使用 API_URL。
# 线上获取：Supabase 项目的 API 设置页面。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 浏览器端公开密钥。必填，可暴露给浏览器。
# 本地获取：运行 `npx supabase status -o env`，使用 PUBLISHABLE_KEY。
# 线上获取：Supabase 项目的 API keys 设置页面。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase 服务端高权限密钥。仅服务端使用，不要暴露给浏览器。
# 本地获取：运行 `npx supabase status -o env`，使用 SECRET_KEY。
# 线上获取：Supabase 项目的 API keys 设置页面。
SUPABASE_SECRET_KEY=

# 以下仅为本地开发用示例，不得直接用于生产。
# 6～12 位数字访问码；生产环境请自行设置随机且不重复的数字码。
ACCESS_CODE=12345678

# 家庭共用 Supabase 用户；本地 seed.sql 中预设相同邮箱和密码。
# 线上通过 Supabase 控制台创建账号后，填写实际邮箱和随机长密码。
FAMILY_ACCOUNT_EMAIL=family@burrowpark.local
FAMILY_ACCOUNT_PASSWORD=BurrowParkLocal!123456
